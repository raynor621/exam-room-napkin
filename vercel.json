{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/grafts",
      "destination": "/grafts.html"
    },
    {
      "source": "/acl-steps",
      "destination": "/acl-steps.html"
    },
    {
      "source": "/kneecap-steps",
      "destination": "/kneecap-steps.html"
    },
    {
      "source": "/meniscus-repair",
      "destination": "/meniscus-repair.html"
    },
    {
      "source": "/recovery",
      "destination": "/recovery.html"
    },
    {
      "source": "/recovery/:topic",
      "destination": "/recovery.html"
    },
    {
      "source": "/arthritis",
      "destination": "/arthritis.html"
    },
    {
      "source": "/learn/arthritis",
      "destination": "/arthritis.html"
    },
    {
      "source": "/explore/arthritis",
      "destination": "/arthritis.html"
    },
    {
      "source": "/learn/kneecap",
      "destination": "/kneecap-steps.html"
    },
    {
      "source": "/explore/kneecap",
      "destination": "/kneecap-steps.html"
    },
    {
      "source": "/learn/meniscus-repair",
      "destination": "/meniscus-repair.html"
    },
    {
      "source": "/explore/meniscus-repair",
      "destination": "/meniscus-repair.html"
    },
    {
      "source": "/learn/meniscus",
      "destination": "/meniscus.html"
    },
    {
      "source": "/explore/meniscus",
      "destination": "/meniscus.html"
    },
    {
      "source": "/explore",
      "destination": "/explore.html"
    },
    {
      "source": "/explore/:path*",
      "destination": "/explore.html"
    },
    {
      "source": "/learn",
      "destination": "/explore.html"
    },
    {
      "source": "/learn/:path*",
      "destination": "/explore.html"
    }
  ],
  "redirects": [
    {
      "source": "/explore",
      "destination": "/learn",
      "permanent": false
    },
    {
      "source": "/explore/:path*",
      "destination": "/learn/:path*",
      "permanent": false
    }
  ]
}
